VITE_API_BASE_URL=http://localhost:8080

# Upload limits shown in the admin editors. These must not exceed the backend's
# UPLOAD_MAX_FILE_SIZE / UPLOAD_MAX_REQUEST_SIZE; the backend still enforces the
# real limit, this only keeps the browser from sending a doomed request.
VITE_UPLOAD_MAX_FILE_SIZE_MB=50
VITE_UPLOAD_MAX_REQUEST_SIZE_MB=100
