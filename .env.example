# Copy this file to .env and fill in the real values. Never commit .env.
# Secrets below are intentionally empty: generate strong, unique values.

# Database
DB_HOST=database
DB_PORT=5432
DB_NAME=photographer_portfolio
DB_USERNAME=postgres
DB_PASSWORD=

# Required secrets (at least 32 bytes each)
JWT_SECRET=
SMTP_ENCRYPTION_KEY=

# Address shown in the footer of the booking e-mail and used for the header
# logo. Local development points at the nginx port in compose.yml.
MAIL_SITE_URL=https://elvove.site

# Base of the admin panel; booking notifications link to
# {MAIL_ADMIN_URL}/admin/bookings?booking=ID.
MAIL_ADMIN_URL=https://elvove.site

# Optional: creates the first admin account while the admins table is empty.
# Ignored once an admin exists. The password must be at least 12 characters and
# must not be a known default.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Frontend origin used for CORS. Local development uses the nginx port; set
# FRONTEND_URL=https://elvove.site in production.
FRONTEND_URL=https://elvove.site

# Upload limits. Both accept size syntax ("50MB", "100MB"). Keep
# UPLOAD_MAX_REQUEST_SIZE equal to nginx/default.conf's client_max_body_size,
# otherwise nginx rejects the request with its own 413 page first.
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=100MB
